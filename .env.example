# Postgres (used by docker compose)
POSTGRES_USER=beacon
POSTGRES_PASSWORD=beacon
POSTGRES_DB=beacon
POSTGRES_PORT=5432

# Backend
# When running inside docker compose the host is overridden to "postgres".
DATABASE_URL=postgresql://beacon:beacon@localhost:5432/beacon?schema=public
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:3000/api
