generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

/// SUPERVISOR has read access to the whole project and reviews contributions.
enum ProjectRole {
  OWNER
  MEMBER
  VIEWER
  SUPERVISOR
}

/// Fixed categories that every custom workflow column maps to.
enum StatusCategory {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum ContributionType {
  DEVELOPMENT
  TESTING
  RESEARCH
  DOCUMENTATION
  MEETING
  OTHER
}

/// DRAFT: still being filled in. SUBMITTED: waiting for a reviewer. APPROVED: locked.
enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  CHANGES_REQUESTED
}

/// Non-teaching weeks inside a semester. They don't get a teaching week number.
enum SemesterBreakKind {
  BREAK
  EXAM
}

/// ONLINE_UPDATE: progress written in Beacon instead of meeting. IN_PERSON: a face-to-face meeting.
enum MeetingMode {
  ONLINE_UPDATE
  IN_PERSON
}

/// Sections A-D of the supervisor meeting record book.
enum MeetingPhase {
  PROBLEM_IDENTIFICATION
  ANALYSIS_DESIGN
  SYSTEM_DESIGN
  DEVELOPMENT_EVALUATION
}

enum MeetingRecordStatus {
  SUBMITTED
  CHANGES_REQUESTED
  CERTIFIED
}

enum SignatureMethod {
  UPLOAD
  DRAWN
  TYPED
}

// ---------------------------------------------------------------------------
// Identity and tenancy
// ---------------------------------------------------------------------------

model User {
  id                 String   @id @default(uuid(7)) @db.Uuid
  githubId           String   @unique @map("github_id")
  githubLogin        String   @unique @map("github_login")
  name               String?
  email              String?
  avatarUrl          String?  @map("avatar_url")
  /// University student registration number, shown in the record book.
  registrationNumber String?  @unique @map("registration_number")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  workspaceMemberships  WorkspaceMember[]
  projectMemberships    ProjectMember[]
  taskAssignments       TaskAssignee[]
  reportedTasks         Task[]                @relation("TaskReporter")
  timesheets            Timesheet[]           @relation("TimesheetAuthor")
  reviewedTimesheets    Timesheet[]           @relation("TimesheetReviewer")
  signature             UserSignature?
  recordBookSignatures  RecordBookSignature[]
  createdMeetings       MeetingRecord[]       @relation("MeetingCreator")
  certifiedMeetings     MeetingRecord[]       @relation("MeetingCertifier")
  meetingsAttended      MeetingAttendee[]

  @@map("users")
}

/// The signature a user saves once and reuses when signing.
model UserSignature {
  userId    String          @id @map("user_id") @db.Uuid
  /// PNG or JPEG data URL.
  image     String
  method    SignatureMethod
  updatedAt DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_signatures")
}

model Workspace {
  id            String    @id @default(uuid(7)) @db.Uuid
  name          String
  slug          String    @unique
  /// Academic calendar shared by every group in the workspace, e.g. "Semester 2, 2026".
  semesterName  String?   @map("semester_name")
  /// Monday of teaching week 1. Set together with `semesterWeeks`.
  semesterStart DateTime? @map("semester_start") @db.Date
  /// Calendar weeks in the semester, including break and exam weeks.
  semesterWeeks Int?      @map("semester_weeks")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  members        WorkspaceMember[]
  projects       Project[]
  semesterBreaks SemesterBreak[]

  @@map("workspaces")
}

model SemesterBreak {
  workspaceId String            @map("workspace_id") @db.Uuid
  /// Monday of the break week; must fall inside the semester (enforced in the API).
  weekStart   DateTime          @map("week_start") @db.Date
  kind        SemesterBreakKind
  label       String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, weekStart])
  @@map("semester_breaks")
}

model WorkspaceMember {
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now()) @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

model Project {
  id             String    @id @default(uuid(7)) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  name           String
  /// Short uppercase prefix for task identifiers, e.g. "BCN" -> BCN-42.
  key            String
  /// Markdown, shown on the project profile like a README.
  description    String?
  /// Square PNG, JPEG or WebP data URL; the initials tile is shown when unset.
  logo           String?
  /// Whether anyone with the link can see the project profile.
  isPublic       Boolean   @default(true) @map("is_public")
  /// Last issued task number; incremented when a task is created.
  taskCounter    Int       @default(0) @map("task_counter")
  /// Last issued record book meeting number.
  meetingCounter Int       @default(0) @map("meeting_counter")
  archivedAt     DateTime? @map("archived_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  workspace            Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members              ProjectMember[]
  statuses             WorkflowStatus[]
  sprints              Sprint[]
  milestones           Milestone[]
  tasks                Task[]
  timesheets           Timesheet[]
  recordBook           RecordBook?
  recordBookSignatures RecordBookSignature[]
  meetings             MeetingRecord[]

  @@unique([workspaceId, key])
  @@map("projects")
}

/// Project members must also be members of the project's workspace (enforced in the API).
model ProjectMember {
  projectId String      @map("project_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now()) @map("joined_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

/// A board column. Each project is seeded with one column per category and can add custom ones.
model WorkflowStatus {
  id        String         @id @default(uuid(7)) @db.Uuid
  projectId String         @map("project_id") @db.Uuid
  name      String
  category  StatusCategory
  position  Int
  color     String?
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([projectId, name])
  @@index([projectId, position])
  @@map("workflow_statuses")
}

// ---------------------------------------------------------------------------
// Planning
// ---------------------------------------------------------------------------

model Sprint {
  id        String       @id @default(uuid(7)) @db.Uuid
  projectId String       @map("project_id") @db.Uuid
  name      String
  goal      String?
  startDate DateTime     @map("start_date") @db.Date
  endDate   DateTime     @map("end_date") @db.Date
  status    SprintStatus @default(PLANNED)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, status])
  @@map("sprints")
}

/// An assessed deliverable (proposal, demo, final report). Progress is derived from its tasks.
model Milestone {
  id          String   @id @default(uuid(7)) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  title       String
  description String?
  dueDate     DateTime @map("due_date") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, dueDate])
  @@map("milestones")
}

model Task {
  id          String       @id @default(uuid(7)) @db.Uuid
  projectId   String       @map("project_id") @db.Uuid
  /// Per-project sequence number, shown as `${project.key}-${number}`.
  number      Int
  title       String
  description String?
  statusId    String       @map("status_id") @db.Uuid
  priority    TaskPriority @default(NONE)
  reporterId  String       @map("reporter_id") @db.Uuid
  sprintId    String?      @map("sprint_id") @db.Uuid
  /// Must belong to the same project (enforced in the API).
  milestoneId String?      @map("milestone_id") @db.Uuid
  dueDate     DateTime?    @map("due_date") @db.Date
  /// Ordering within a board column.
  position    Float        @default(0)
  completedAt DateTime?    @map("completed_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status    WorkflowStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)
  reporter  User           @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  sprint    Sprint?        @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  milestone Milestone?     @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  assignees     TaskAssignee[]
  blockedBy     TaskDependency[]    @relation("BlockedTask")
  blocking      TaskDependency[]    @relation("BlockingTask")
  contributions ContributionEntry[]

  @@unique([projectId, number])
  @@index([projectId, statusId, position])
  @@index([sprintId])
  @@index([milestoneId])
  @@map("tasks")
}

/// Assignees must be members of the task's project (enforced in the API).
model TaskAssignee {
  taskId     String   @map("task_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_assignees")
}

/// `blockingTask` must be completed before `blockedTask` can proceed.
model TaskDependency {
  blockingTaskId String   @map("blocking_task_id") @db.Uuid
  blockedTaskId  String   @map("blocked_task_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  blockingTask Task @relation("BlockingTask", fields: [blockingTaskId], references: [id], onDelete: Cascade)
  blockedTask  Task @relation("BlockedTask", fields: [blockedTaskId], references: [id], onDelete: Cascade)

  @@id([blockingTaskId, blockedTaskId])
  @@index([blockedTaskId])
  @@map("task_dependencies")
}

// ---------------------------------------------------------------------------
// Contributions
// ---------------------------------------------------------------------------

/// One member's week in one project. Hours are self-reported, never derived from GitHub activity,
/// and the whole week is submitted and reviewed together.
model Timesheet {
  id            String          @id @default(uuid(7)) @db.Uuid
  projectId     String          @map("project_id") @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  /// Monday of the ISO week.
  weekStart     DateTime        @map("week_start") @db.Date
  status        TimesheetStatus @default(DRAFT)
  submittedAt   DateTime?       @map("submitted_at")
  reviewedById  String?         @map("reviewed_by_id") @db.Uuid
  reviewedAt    DateTime?       @map("reviewed_at")
  reviewComment String?         @map("review_comment")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User                @relation("TimesheetAuthor", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy User?               @relation("TimesheetReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  entries    ContributionEntry[]

  @@unique([projectId, userId, weekStart])
  @@index([projectId, weekStart])
  @@index([userId, weekStart])
  @@index([status])
  @@map("timesheets")
}

/// A timesheet row: a work type and optionally a task, with hours per day.
model ContributionEntry {
  id             String           @id @default(uuid(7)) @db.Uuid
  timesheetId    String           @map("timesheet_id") @db.Uuid
  /// Sum of the row's days, kept in sync by the API.
  hours          Decimal          @default(0) @db.Decimal(5, 2)
  type           ContributionType
  taskId         String?          @map("task_id") @db.Uuid
  description    String           @default("")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  timesheet Timesheet         @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  task      Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  days      ContributionDay[]

  @@index([timesheetId])
  @@index([taskId])
  @@map("contribution_entries")
}

/// Hours on one day of a timesheet row. The date must fall in the row's week (enforced in the API).
model ContributionDay {
  entryId   String   @map("entry_id") @db.Uuid
  date      DateTime @db.Date
  hours     Decimal  @db.Decimal(4, 2)
  note      String?
  updatedAt DateTime @updatedAt @map("updated_at")

  entry ContributionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([entryId, date])
  @@map("contribution_days")
}

// ---------------------------------------------------------------------------
// Supervisor meeting record book
// ---------------------------------------------------------------------------

/// Cover and details page of a group's record book.
model RecordBook {
  projectId   String   @id @map("project_id") @db.Uuid
  moduleTitle String   @default("IS2901 - Software Development Project") @map("module_title")
  level       String   @default("Level 02")
  batch       String?
  groupName   String?  @map("group_name")
  department  String?
  faculty     String?
  university  String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("record_books")
}

/// A member or supervisor signing the details page. The image is a copy of their signature at that time.
model RecordBookSignature {
  projectId String   @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  image     String
  signedAt  DateTime @default(now()) @map("signed_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("record_book_signatures")
}

model MeetingRecord {
  id                String              @id @default(uuid(7)) @db.Uuid
  projectId         String              @map("project_id") @db.Uuid
  /// Per-project sequence number, the "Meeting Number" in the book.
  number            Int
  phase             MeetingPhase
  mode              MeetingMode
  meetingDate       DateTime            @map("meeting_date") @db.Date
  summary           String
  createdById       String              @map("created_by_id") @db.Uuid
  status            MeetingRecordStatus @default(SUBMITTED)
  supervisorComment String?             @map("supervisor_comment")
  certifiedById     String?             @map("certified_by_id") @db.Uuid
  certifiedAt       DateTime?           @map("certified_at")
  /// Copy of the certifier's signature, so later signature changes don't alter the record.
  signatureImage    String?             @map("signature_image")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User              @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: Restrict)
  certifiedBy User?             @relation("MeetingCertifier", fields: [certifiedById], references: [id], onDelete: SetNull)
  attendees   MeetingAttendee[]

  @@unique([projectId, number])
  @@index([projectId, phase])
  @@index([projectId, status])
  @@map("meeting_records")
}

/// "Group Members Present" for in-person meetings, contributors for online updates.
model MeetingAttendee {
  meetingId String @map("meeting_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid

  meeting MeetingRecord @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
  @@index([userId])
  @@map("meeting_attendees")
}
